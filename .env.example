APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# قاعدة البيانات: للتشغيل السريع sqlite، وللإنتاج يُنصح بـ mysql
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=agri_accounting
# DB_USERNAME=root
# DB_PASSWORD=

# بيانات حساب المدير الذي يُنشأ عند تشغيل: php artisan db:seed
ADMIN_NAME="مدير النظام"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@agri.local
ADMIN_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================
# إعدادات البريد الإلكتروني (Gmail SMTP)
# ==============================
# القيم أدناه هي إعدادات Gmail القياسية. لتفعيل الإرسال الفعلي:
#   1) فعّل التحقق بخطوتين في حساب Google.
#   2) أنشئ "كلمة مرور التطبيقات" (App Password) المكوّنة من 16 حرفاً:
#      https://myaccount.google.com/apppasswords
#   3) ضع بريدك في MAIL_USERNAME و MAIL_FROM_ADDRESS وكلمة مرور التطبيقات في MAIL_PASSWORD.
#   4) غيّر MAIL_MAILER إلى smtp (اتركها log أثناء التطوير لتُكتب الرسائل في storage/logs).
MAIL_MAILER=log
# MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD="app-password-16-chars"
MAIL_FROM_ADDRESS="your-account@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# إرسال رسائل النظام عبر طابور المهام (يتطلب: php artisan queue:work)
# اتركها false للإرسال المباشر أثناء الطلب.
MAIL_QUEUE_NOTIFICATIONS=false
MAIL_QUEUE_NAME=emails

# ==============================
# المرفقات (صور الفواتير وسندات القبض)
# ==============================
ATTACHMENTS_DISK=public
ATTACHMENTS_MAX_SIZE_KB=4096

# ==============================
# حدود التنبيهات الذكية
# ==============================
# تنبيه عند تجاوز دين التاجر هذا المبلغ بالدولار
ALERT_DEBT_THRESHOLD_USD=500
# تنبيه عند مرور هذه المدة (أيام) دون أي دفعة من تاجر عليه دين
ALERT_DEBT_IDLE_DAYS=30
# تنبيه عند تجاوز مصاريف الموسم/المحصول هذه النسبة من الإيراد (0.8 = 80%)
ALERT_EXPENSE_RATIO=0.8
# تنبيه على المواسم النشطة التي صُرف عليها ولم تُسجَّل لها مبيعات خلال هذه المدة (أيام)
ALERT_SEASON_IDLE_DAYS=120

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
